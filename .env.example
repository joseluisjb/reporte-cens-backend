# Usuario de la base de datos Oracle (el esquema al que se conecta la aplicación)
ORACLE_USER=

# Contraseña del usuario Oracle
ORACLE_PASSWORD=

# DSN de conexión: nombre del servicio tal como aparece en tnsnames.ora del wallet
# (por ejemplo: mibasededatos_high, mibasededatos_medium, mibasededatos_low)
ORACLE_DSN=

# Ruta absoluta a la carpeta del wallet descargado desde Oracle Cloud (fuera del repositorio)
# Ejemplo en Windows: C:\wallets\mi_wallet
ORACLE_WALLET_DIR=

# Contraseña del wallet (se establece al descargarlo desde Oracle Cloud)
ORACLE_WALLET_PASSWORD=

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SESSION_MINUTES=10
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_LOGIN_RATE=10/min
DJANGO_NUM_PROXIES=0
