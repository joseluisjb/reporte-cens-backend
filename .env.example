# Usuario de la base de datos Oracle (el esquema al que se conecta la aplicación)
ORACLE_USER=

# Contraseña del usuario Oracle
ORACLE_PASSWORD=

# DSN de conexión: nombre del servicio tal como aparece en tnsnames.ora del wallet
# (por ejemplo: mibasededatos_high, mibasededatos_medium, mibasededatos_low)
ORACLE_DSN=

# Ruta absoluta a la carpeta del wallet descargado desde Oracle Cloud (fuera del repositorio)
# Ejemplo en Windows: C:\wallets\mi_wallet
ORACLE_WALLET_DIR=

# Contraseña del wallet (se establece al descargarlo desde Oracle Cloud)
ORACLE_WALLET_PASSWORD=

# Django
# Obligatoria con DJANGO_DEBUG=False (no hay valor por defecto). En desarrollo puede quedar vacía.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SESSION_MINUTES=10
DJANGO_LOG_LEVEL=WARNING
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_LOGIN_RATE=10/min
DJANGO_NUM_PROXIES=0

# Correo electrónico (en desarrollo, usar consola)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=

# Recuperación de contraseña
FRONTEND_URL=
DJANGO_PASSWORD_RESET_RATE=5/hour

# Backend de correo por Google Apps Script (alternativa a SMTP cuando los puertos 25/465/587 están bloqueados)
# Ver docs/correo_apps_script.md para instrucciones de configuración.
DJANGO_APPS_SCRIPT_URL=
DJANGO_APPS_SCRIPT_TOKEN=
DJANGO_EMAIL_TIMEOUT=20
